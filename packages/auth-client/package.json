{
  "name": "@d3cloudio/auth-client",
  "private": false,
  "version": "0.1.0",
  "description": "Relying-party SDK for D3 Auth: sign-in, identity by (iss, sub), roles, and back-channel logout",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "openid-client": "^6.8.8"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.3.0",
    "@types/react": "^19.3.0"
  },
  "keywords": [
    "oidc",
    "openid-connect",
    "oauth2",
    "sso",
    "authentication",
    "d3-auth",
    "pkce",
    "back-channel-logout"
  ],
  "homepage": "https://github.com/matdemers1/d3-auth/tree/main/packages/auth-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matdemers1/d3-auth.git",
    "directory": "packages/auth-client"
  },
  "bugs": {
    "url": "https://github.com/matdemers1/d3-auth/issues"
  },
  "author": "Matthew Demers",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js",
        "default": "./dist/react.js"
      }
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js"
  }
}

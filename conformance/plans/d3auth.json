{
  "alias": "d3auth",
  "description": "D3 Auth — static clients, discovery, dev login (Phase 0)",
  "server": {
    "discoveryUrl": "https://op.d3auth.test/.well-known/openid-configuration"
  },
  "client": {
    "client_id": "conformance-1",
    "client_secret": "conformance-client-1-secret-ephemeral-stack-only"
  },
  "client2": {
    "client_id": "conformance-2",
    "client_secret": "conformance-client-2-secret-ephemeral-stack-only"
  },
  "browser": [
    {
      "match": "https://op.d3auth.test/oidc/auth*",
      "tasks": [
        {
          "task": "Email",
          "match": "https://op.d3auth.test/login/*",
          "commands": [
            [
              "text",
              "name",
              "email",
              "conformance@d3auth.test"
            ],
            [
              "click",
              "css",
              "button[type=submit]"
            ]
          ],
          "optional": true
        },
        {
          "task": "Password",
          "match": "https://op.d3auth.test/login/*",
          "commands": [
            [
              "text",
              "name",
              "password",
              "conformance-suite-password-only"
            ],
            [
              "click",
              "css",
              "button[type=submit]"
            ]
          ],
          "optional": true
        },
        {
          "task": "Verify Complete",
          "match": "*/test/*/callback*",
          "commands": [
            [
              "wait",
              "id",
              "submission_complete",
              10
            ]
          ]
        }
      ]
    }
  ],
  "override": {
    "oidcc-prompt-login": {
      "browser": [
        {
          "comment": "screenshot the second sign-in page",
          "match": "https://op.d3auth.test/oidc/auth*",
          "tasks": [
            {
              "task": "Email",
              "match": "https://op.d3auth.test/login/*",
              "commands": [
                [
                  "wait",
                  "xpath",
                  "//*",
                  10,
                  "Sign in",
                  "update-image-placeholder-optional"
                ],
                [
                  "text",
                  "name",
                  "email",
                  "conformance@d3auth.test"
                ],
                [
                  "click",
                  "css",
                  "button[type=submit]"
                ]
              ],
              "optional": true
            },
            {
              "task": "Password",
              "match": "https://op.d3auth.test/login/*",
              "commands": [
                [
                  "text",
                  "name",
                  "password",
                  "conformance-suite-password-only"
                ],
                [
                  "click",
                  "css",
                  "button[type=submit]"
                ]
              ],
              "optional": true
            },
            {
              "task": "Verify Complete",
              "match": "*/test/*/callback*",
              "commands": [
                [
                  "wait",
                  "id",
                  "submission_complete",
                  10
                ]
              ]
            }
          ]
        }
      ]
    },
    "oidcc-max-age-1": {
      "browser": [
        {
          "comment": "screenshot the second sign-in page",
          "match": "https://op.d3auth.test/oidc/auth*",

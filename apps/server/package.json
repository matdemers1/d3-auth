{
  "name": "d3auth-server",
  "private": true,
  "version": "0.0.0",
  "description": "OIDC provider, interaction routes, console/account API and CLI",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:adversarial": "vitest run --project adversarial",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "flow": "node scripts/flow.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "^14.0.2",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "nodemailer": "^10.0.10",
    "oidc-provider": "^9.12.2",
    "otpauth": "^9.5.2",
    "pino": "^10.3.1",
    "prisma": "7.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/oidc-provider": "^9.12.1",
    "openid-client": "^6.8.8",
    "tsx": "^4.23.13",
    "@d3cloud/auth-client": "workspace:*",
    "jose": "^6.2.12"
  }
}

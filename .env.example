# Issuer and ingress (the service always trusts forwarded headers: only the tunnel reaches it)
ISSUER=https://auth.d3cloud.io
PORT=3000
# Local testing only, and only for localhost or *.test issuers:
# INSECURE_HTTP_ISSUER=true
# DEV_LOGIN_ENABLED=true   # Phase 0 throwaway login, removed in Phase 1

# Database — compose builds DATABASE_URL for the server from POSTGRES_PASSWORD.
# Set DATABASE_URL yourself only when running the server outside compose (pnpm dev).
POSTGRES_PASSWORD=d3auth
DATABASE_URL=postgresql://d3auth:d3auth@127.0.0.1:5432/d3auth

# Secrets — generate with: openssl rand -base64 32
KEK=                # wraps TOTP secrets and signing private keys at rest
PEPPER=             # mixed into Argon2id password hashes
COOKIE_KEYS=        # comma-separated, first is current

# Mail adapter: worker | smtp
MAIL_DRIVER=worker
MAIL_RELAY_URL=https://mail-relay.example.workers.dev/send
MAIL_RELAY_SECRET=
MAIL_FROM=no-reply@no-reply.d3cloud.io
SMTP_URL=

# Operator
OPERATOR_DISPLAY_NAME=Matthew
ALERT_RECIPIENTS=

# Backups (Phase 6)
S3_BUCKET=
S3_REGION=
S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Seed file applied on boot (optional)
SEED_FILE=/app/d3auth.seed.json
